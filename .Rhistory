left_rect <- function(f, a, b, n){
grid = seq(a, b, len = n + 1)
h = (b - a) / n
rslt = sum(h * f(grid[1:n]))
return(rslt)
}
trapezoid <- function(f, a, b, n){
grid = seq(a, b, len = n + 1)
h = (b - a) / n
rslt = (h/2) * (f(grid[1]) + 2 * sum(f(grid[2:n])) + f(grid[n + 1]))
return(rslt)
}
simpson <- function(f, a, b, n){ # n은 짝수라고 가정
grid = seq(a, b, len = n + 1)
# 여기 뭐 수정사항 잇는듯
idx_for_odd = seq(2, n, by = 2)
idx_for_even = seq(3, n - 1, by = 2)
h = (b - a) / n
rslt = (h/3) * (f(grid[1]) + 4 * sum(f(grid[idx_for_odd])) +
2 * sum(f(grid[idx_for_even])) + f(grid[n + 1]))
return(rslt)
}
