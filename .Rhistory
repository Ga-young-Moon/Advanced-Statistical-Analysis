# 2. 내림차순 정렬(decreasing = TRUE)
x_desc = bubble_sort(x, decreasing = TRUE)
print('***2. 내림차순 결과***')
print(x_desc)
quick_sort <- function(x, decreasing = FALSE){
if (length(x) <= 1) return(x) # 종료 조건
pivot = sample(x, 1)
if(!decreasing){
left = x[x < pivot]
mid = x[x == pivot]
right = x[x > pivot]
return(c(quick_sort(left, decreasing), mid, quick_sort(right, decreasing)))
} else{
left = x[x > pivot]
mid = x[x == pivot]
right = x[x < pivot]
return(c(quick_sort(left, decreasing), mid, quick_sort(right, decreasing)))
}
}
