gaussian_kernel <- function(x, z, rho = 1){
return(-exp(rho * (x - z)^2))
}
krr <- function(X, y, rho = 1, lambda = 0.0001){
n = nrow(X)
K = matrix(0, ncol = n, nrow = n)
for (i in 1:n){
for (j in 1:n){
K[i, j] = gaussian_kernel(X[i, ], X[j, ])
}
}
coef_hat = solve(K + diag(lambda, n), y)
rslt = list('coefficients' = coef_hat,
'fitted_values' = K %*%coef_hat,
'rho' = rho,
'X' = X,
'y' = y)
class(rslt) = 'krr'
return(rslt)
}
predict.krr <- function(model, X_new, ...){
X = model$X
n = nrow(X)
n_new = nrow(X_new)
K_new = matrix(0, ncol = n, nrow = n_new)
for (i in 1:n_new){
for (j in 1:n){
K_new[i, j] = exp(-model$rho * sum((X_new[i, ] - X[j, ])^2))
}
}
pred_values = K_new%*%model$coefficients
return(pred_values)
}
library(ggplot2)
plot.krr <- function(model, grid_x, ...){
y_preds = predict(model, grid_x)
data_plot = data.frame(x = model$X, y = model$y)
krr_plot = data.frame(x = grid_x, y = y_preds)
ggplot() +
geom_point(data = data_plot, aes(x = x, y = y)) +
geom_line(data = krr_plot, color = 'blue', linewidth = 1.2, aes(x, y)) +
labs(title = 'Kernel Ridge Regression')
}
