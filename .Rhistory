A <- matrix(c(4, 2, 2, 2, 5, 1, 2, 1, 3), 3)
L <- t(chol(A))
A
L%*%t(L)
forward <- function(L, b){
coef = rep(0, nrow(b))
n = length(coef)
# first elements
coef[1] = b[1] / L[1, 1]
for (i in 2:n){
coef[i] = (b[i] - sum(L[i, 1:(i - 1)] * coef[1:(i - 1)])) / L[i, i]
}
return(coef)
}
backward <- function(U, b){
coef = rep(0, nrow(U))
n = length(coef)
# last elements
coef[n] = b[n] / U[n, n]
for (i in (n-1):1){
coef[i] = (b[i] - sum(U[i, (i + 1):n] * coef[(i + 1):n])) / U[i, i]
}
return(coef)
}
b <- matrix(c(1, -2, 3))
z_manual = forward(L, b)
x_manual = backward(t(L), z_manual)
# solve와 비교
x_solve = as.vector(solve(A, b))
print(x_solve)
print(x_manual)
gaussian_kernel <- function(x, z, rho = 1){
return(-exp(rho * (x - z)^2))
}
krr <- function(X, y, rho = 1, lambda = 0.0001){
n = nrow(X)
K = matrix(0, ncol = n, nrow = n)
for (i in 1:n){
for (j in 1:n){
K[i, j] = gaussian_kernel(X[i, ], X[j, ])
}
}
coef_hat = solve(K + diag(lambda, n), y)
rslt = list('coefficients' = coef_hat,
'fitted_values' = K %*%coef_hat,
'rho' = rho,
'X' = X,
'y' = y)
class(rslt) = 'krr'
}
krr <- function(X, y, rho = 1, lambda = 0.0001){
n = nrow(X)
K = matrix(0, ncol = n, nrow = n)
for (i in 1:n){
for (j in 1:n){
K[i, j] = gaussian_kernel(X[i, ], X[j, ])
}
}
coef_hat = solve(K + diag(lambda, n), y)
rslt = list('coefficients' = coef_hat,
'fitted_values' = K %*%coef_hat,
'rho' = rho,
'X' = X,
'y' = y)
class(rslt) = 'krr'
return(rslt)
}
predict.krr <- function(model, X_new, ...){
X = model$X
n = nrow(X)
n_new = nrow(X_new)
K_new = matrix(0, ncol = n, nrow = n_new)
for (i in 1:n_new){
for (j in 1:n){
K_new[i, j] = exp(-model$rho * sum((X_new[i, ] - X[j, ])^2))
}
}
pred_values = K_new%*%model$coefficients
return(pred_values)
}
