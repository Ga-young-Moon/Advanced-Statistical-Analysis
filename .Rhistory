bubble_sort <- function(x, decreasing = FALSE){
n = length(x)
for (i in 1:(n-1)){
for (j in 1:(n-1)){
if((!decreasing && x[j] > x[j+1]) ||
(decreasing && x[j] < x[j+1])){
tmp = x[j]
x[j] = x[j+1]
x[j+1] = tmp
}
}
}
return(x)
}
set.seed(1)
x = runif(10)
