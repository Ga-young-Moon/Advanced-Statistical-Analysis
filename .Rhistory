forward <- function(L, b){
coef = rep(0, nrow(b))
n = length(coef)
# first elements
coef[1] = b[1] / L[1, 1]
for (i in 2:n){
coef[i] = (b[i] - sum(L[i, 1:(i - 1)] * coef[1:(i - 1)])) / L[i, i]
}
return(coef)
}
backward <- function(U, b){
coef = rep(0, nrow(U))
n = length(coef)
# last elements
coef[n] = b[n] / U[n, n]
for (i in (n-1):1){
coef[i] = (b[i] - sum(U[i, (i + 1):n] * coef[(i + 1):n])) / U[i, i]
}
return(coef)
}
