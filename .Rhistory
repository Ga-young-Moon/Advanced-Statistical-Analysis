num_deriv <- function(f, x, h= 1e - 6, method = 'forward'){
num_deriv <- function(f, x, h= 1e-6, method = 'forward'){
if (method == 'forward'){
return((f(x + h) - f(x)) / h)
} else if (method == 'backward'){
return((f(x) - f(x - h)) / h)
} else if (method == 'central'){
return((f(x + h) - f(x - h)) / (2 * h))
} else {
stop("method must be 'forward', 'backward', or 'central'")
}
}
f = function(x) cos(x) - x
f_prime = function(x) -sin(x) - 1
x = seq(0, 2*pi, length.out = 100)
h = 1e-6
true = f_prime(x)
# sapply to return a vector(sapply 함수를 사용하면 결과가 벡터로 반환)
forward = sapply(x, function(z) num_deriv(f, z, h= h, method= 'forward'))
backward = sapply(x, function(z) num_deriv(f, z, h= h, method= 'backward'))
central = sapply(x, function(z) num_deriv(f, z, h= h, method= 'central'))
df = data.frame(x = x, true = true, forward = forward, backward = backward, central = central)
df
library(ggplot2)
ggplot(df, aes(x = x)) +
geom_line(aes(y = true, color = 'true'), linewidth = 0.8) +
geom_line(aes(y = forward, color = 'forward'), linewidth = 0.8) +
geom_line(aes(y = backward, color = 'backward'), linewidth = 0.8) +
geom_line(aes(y = central, color = 'central'), linewidth = 0.8) +
labs(title = 'Analytic vs Numerical Derivatives of f(x)= cos(x)-x',
x = 'x', y = 'derivative', color = 'method') +
theme_minimal()
newton_rapshon <- function(f, fprime = NULL, x0, h = 1e-6,
maxiter = 100, epsilon = 1e-10){
x = x0
for (i in 1:maxiter){
if (is.null(fprime)){
fp = num_deriv(f, x, h = h, method = 'central')
} else {
fp = fprime(x)
}
x_new = x - f(x) / fp
if (abs(x_new - x) < epsilon){
return(list(solution = x_new, iter = i, converged = TRUE))
}
x = x_new
}
return(list(solution = x, iter = maxiter, converged = FALSE))
}
